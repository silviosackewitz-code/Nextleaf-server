# Build from this checkout before starting Compose. No registry release is assumed.
TASKMANAGER_IMAGE=nextleaf-server:0.4.0-local
NEXTLEAF_DATA_DIR=/srv/nextleaf
NEXTLEAF_MCP_TOKEN=
NEXTLEAF_MCP_HOSTS=localhost,127.0.0.1
# Set the exact private HTTPS hostname; never use a wildcard.
# NEXTLEAF_HTTP_HOSTS=nextleaf.example.ts.net
